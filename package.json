{
  "name": "photo-picker-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 照片工作台：本机照片扫描、AI 分层筛选、人工复核与导出。",
  "scripts": {
    "test": "node --test \"plugin/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "acceptance:1": "node scripts/acceptance-phase1.mjs",
    "acceptance:2": "node scripts/acceptance-phase2.mjs",
    "acceptance:4": "node scripts/acceptance-phase4.mjs",
    "acceptance:5": "node scripts/acceptance-phase5.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "verify": "npm test && npm run typecheck && npm run check:release && npm run check:hygiene && npm run build:client && npm run fixtures && npm run acceptance:1 && npm run acceptance:2 && npm run acceptance:4 && npm run acceptance:5",
    "publish:npm": "cd plugin && npm publish --registry=https://registry.npmjs.org --access public"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "nanoid": "^6.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uoiszero/dsh-photo-picker.git"
  },
  "license": "MIT"
}
