{
  "name": "dsh-photo-picker",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "screenshots.json",
    "LICENSE"
  ],
  "dependencies": {
    "sharp": "^0.35.0",
    "exifr": "^7.1.3",
    "nanoid": "^5.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "description": "DSH photo picker workbench: scan, AI triage, review and export.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uoiszero/dsh-photo-picker.git",
    "directory": "plugin"
  },
  "license": "MIT"
}
